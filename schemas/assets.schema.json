{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mille-feuilles.invalid/schemas/assets.schema.json",
  "title": "Mille Feuilles assets 0.2.0 / 0.3.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.2.0",
        "0.3.0"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "text",
              "font",
              "texture",
              "illustration",
              "template"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unresolved"
                ]
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "evidence_uri": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "redistribution_allowed": {
                "type": "boolean"
              },
              "extensions": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
                }
              }
            },
            "required": [
              "status",
              "license",
              "evidence_uri",
              "attribution",
              "redistribution_allowed"
            ],
            "additionalProperties": false
          },
          "metadata": {
            "type": "object"
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "source_uri",
          "rights",
          "metadata"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
      }
    }
  },
  "required": [
    "schema_version",
    "assets"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.3.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "if": {
                "properties": {
                  "kind": {
                    "const": "text"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "enum": [
                          "body",
                          "title",
                          "advertisement"
                        ]
                      },
                      "source_document_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "source_group_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "language": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
                      },
                      "date": {
                        "type": "string",
                        "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?(?![\\s\\S])"
                      },
                      "historical_corpus": {
                        "type": "boolean"
                      },
                      "units": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "evidence_files": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                            }
                          },
                          "required": [
                            "path",
                            "sha256"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "role",
                      "source_document_id",
                      "source_group_id",
                      "language",
                      "evidence_files"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
