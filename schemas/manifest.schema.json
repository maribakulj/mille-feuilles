{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mille-feuilles.invalid/schemas/manifest-0.2-0.3.schema.json",
  "title": "Mille Feuilles manifest 0.2.0 / 0.3.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.2.0",
        "0.3.0"
      ]
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])"
    },
    "profile": {
      "enum": [
        "fr_press_19c_columns_4_6",
        "fr_press_19c_columns_4_6_measured",
        "fr_press_19c_layout_v2"
      ]
    },
    "generator": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
        },
        "dirty": {
          "type": "boolean"
        },
        "environment_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
          }
        }
      },
      "required": [
        "commit",
        "dirty",
        "environment_path",
        "environment_sha256"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
          }
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "rng": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
          }
        }
      },
      "required": [
        "algorithm",
        "version",
        "seed"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
          }
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "protocol_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "source_partitions": {
          "type": "array",
          "items": {
            "enum": [
              "train",
              "dev"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "files_read": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "extensions": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
              }
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
          }
        }
      },
      "required": [
        "protocol_path",
        "protocol_sha256",
        "source_partitions",
        "files_read"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "source_group_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
            }
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "source_group_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
            }
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*:"
      },
      "properties": {
        "mf:degradation_profile": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "provenance/degradation-profile.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "additionalProperties": false
        },
        "mf:content_profile": {
          "type": "object",
          "properties": {
            "version": {
              "const": "1"
            },
            "profile": {
              "const": "consecutive-v1"
            },
            "calibrated": {
              "const": false
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])"
                  },
                  "source_document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                  },
                  "unit_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible": {
                    "type": "boolean"
                  },
                  "reason": {
                    "enum": [
                      null,
                      "fewer_than_two_body_units"
                    ]
                  }
                },
                "required": [
                  "asset_id",
                  "source_document_id",
                  "sha256",
                  "unit_count",
                  "eligible",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "version",
            "profile",
            "calibrated",
            "documents"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "profile",
    "generator",
    "config",
    "rng",
    "assets",
    "calibration",
    "pages",
    "artifacts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "fr_press_19c_columns_4_6_measured",
              "fr_press_19c_layout_v2"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "0.3.0"
          },
          "extensions": {
            "required": [
              "mf:degradation_profile"
            ]
          }
        },
        "required": [
          "extensions"
        ]
      },
      "else": {
        "properties": {
          "extensions": {
            "not": {
              "required": [
                "mf:degradation_profile"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "extensions"
        ],
        "properties": {
          "extensions": {
            "required": [
              "mf:content_profile"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "fr_press_19c_layout_v2"
          },
          "schema_version": {
            "const": "0.3.0"
          }
        }
      }
    }
  ]
}
